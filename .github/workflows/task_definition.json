{
  "family": "documentportaltd",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::139154209916:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::139154209916:role/ecsTaskExecutionRole",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "8192",
  "containerDefinitions": [
    {
      "name": "document-portal-container",
      "image": "139154209916.dkr.ecr.ap-southeast-2.amazonaws.com/documentportalliveclass",
      "cpu": 1024,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "name": "document-portal-container-8080-tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "ENV",
          "value": "production"
        },
        {
          "name": "S3_BUCKET_NAME",
          "value": "knowledgeos-faiss-139154209916-ap-southeast-2-an"
        },
        {
          "name": "AWS_REGION",
          "value": "ap-southeast-2"
        },
        {
          "name": "LANGSMITH_TRACING",
          "value": "true"
        },
        {
          "name": "LANGSMITH_PROJECT",
          "value": "document-portal"
        }
      ],
      "secrets": [
        {
          "name": "API_KEYS",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:139154209916:secret:apikeyliveclass-MxR3uy"
        },
        {
          "name": "MONGO_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:139154209916:secret:apikeyliveclass-MxR3uy:MONGO_URL::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/documentportaltd",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}